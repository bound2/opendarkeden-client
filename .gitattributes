# Byte-compared by tests/unit/test_wire_layout.cpp and the wire_inventory_fresh
# ctest; a CRLF checkout would report every line as a protocol change.
tests/wire-layout.txt text eol=lf
tests/generated/*.inc text eol=lf

# Parsed line-by-line by check_includes.pl, CMake's file(STRINGS) and the
# ratchet script / executed by bash; keep LF so a CRLF checkout cannot
# corrupt baseline keys, membership paths or the shebang line.
tests/arch/*.txt text eol=lf
tests/arch/*.pl text eol=lf
tests/ratchet/*.sh text eol=lf
# The Linux verification script, the reference image and the workflows:
# executed by bash, docker and the runner, so LF for the same reason.
tools/ci/*.sh text eol=lf
tools/linux/Dockerfile text eol=lf
.github/workflows/*.yml text eol=lf

# The audit scripts, for the same reason: all three carry a shebang, and
# all three are LF in the repository already - this only stops a CRLF
# checkout from being the first thing to change that.
tests/tools/*.pl text eol=lf

# Golden wire bytes (tests/unit/test_packet_goldens.cpp): one hex line per
# file, compared byte for byte and shared with the server repo's copies.
tests/golden/*.hex text eol=lf

# Executed by sh as a git hook after `git config core.hooksPath tools/git-hooks`;
# a CRLF checkout would put a carriage return in every command.
tools/git-hooks/* text eol=lf

# Much of the legacy C++ tree is stored as CRLF. Keep diff whitespace checks
# sensitive to real trailing spaces without treating the CR terminator itself
# as trailing whitespace.
*.cpp whitespace=cr-at-eol
*.h whitespace=cr-at-eol
