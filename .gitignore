# ==========================================
# Visual Studio 2019 & MSVC
# ==========================================
.vs/
*.user
*.userosv
*.suo
*.sln.docstates
*.vcxproj.user
# Written by Visual Studio when it opens the folder directly; local IntelliSense
# configuration, not part of the build.
CppProperties.json
CMakeUserPresets.json
vcpkg_installed/

# Visual Studio Build Outputs & Folders
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
x64/
x86/
out/
# CMake-generated build trees. These bake in absolute paths from the machine
# that generated them, so they are never portable between clones - regenerate
# locally instead (see README.md).
[Bb]uild/

# MSVC Compiled Artifacts
*.obj
*.exe
*.dll
*.lib
*.pdb
*.idb
*.ilk
*.exp
*.res
*.pch
*.tlog
*.lastbuildstate
*.log

# ==========================================
# CMake Generated Files
# ==========================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake
!CMakeLists.txt
# *.cmake above is aimed at what an in-source build drops beside the
# sources. It also swallows hand-written CMake scripts, which is how
# tests/tools/check_wire_inventory_fresh.cmake went missing from the
# commit that registered the test using it.
!tests/tools/*.cmake
# The same blanket rule would swallow a hand-written module under
# cmake/ the moment one is added (the Linux/macOS port plans to).
!cmake/*.cmake
.cache

# ==========================================
# OS & Backup Files
# ==========================================
# macOS
.DS_Store
*.dSYM/

# Windows
Thumbs.db
desktop.ini

# Backup files
*.bak
*_bak*
*.old

# General Compiled Binaries
*.o
*.a
*.so
*.dylib

# Scratch files written by the file I/O unit tests. They are created in
# the working directory, which is the build directory under CTest but the
# repository root when the test binary is run by hand.
*_test.bin
